#!/usr/bin/env bash
# ==============================================================================
# LocalCoders — Open-Source Multi-Agent AI Coding IDE based on Code - OSS
# ==============================================================================

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CODE_OSS_DIR="/home/juan/localcoders-oss"

if [ ! -d "${CODE_OSS_DIR}" ]; then
  CODE_OSS_DIR="${SCRIPT_DIR}/vscode-src"
fi

export VSCODE_SKIP_PRELAUNCH=1
export VSCODE_SKIP_NODE_VERSION_CHECK=1
export ELECTRON_ENABLE_STACK_DUMPING=1

# ------------------------------------------------------------------------------
# Graceful Process & Ollama Model Shutdown Handler
# ------------------------------------------------------------------------------
cleanup() {
  echo ""
  echo "=================================================================="
  echo "[LocalCoders] Closing application: Stopping all processes & models"
  echo "=================================================================="

  # 1. Kill any child processes of this launcher script
  pkill -P $$ 2>/dev/null || true

  # 2. Stop and unload all Ollama models from memory/VRAM
  echo "[LocalCoders] Unloading active Ollama models to free GPU/RAM..."
  if command -v ollama >/dev/null 2>&1; then
    for model in $(ollama ps 2>/dev/null | awk 'NR>1 {print $1}'); do
      if [ -n "$model" ]; then
        echo "[LocalCoders] Stopping Ollama model: $model"
        ollama stop "$model" 2>/dev/null || true
      fi
    done
  fi

  # Also directly trigger REST API model unload via keep_alive: 0
  API_PS=$(curl -s --max-time 2 http://127.0.0.1:11434/api/ps 2>/dev/null || true)
  if [ -n "$API_PS" ]; then
    MODELS=$(echo "$API_PS" | grep -o '"name":"[^"]*"' | cut -d'"' -f4)
    for m in $MODELS; do
      if [ -n "$m" ]; then
        echo "[LocalCoders] Unloading $m via API..."
        curl -s --max-time 3 http://127.0.0.1:11434/api/generate -d "{\"model\":\"$m\",\"keep_alive\":0}" >/dev/null 2>&1 || true
      fi
    done
  fi

  # 3. Clean up any stray child processes from this IDE session
  if [ -n "$CODE_PID" ] && kill -0 "$CODE_PID" 2>/dev/null; then
    kill -TERM "$CODE_PID" 2>/dev/null || true
    for _ in {1..10}; do
      if ! kill -0 "$CODE_PID" 2>/dev/null; then
        break
      fi
      sleep 0.2
    done
    if kill -0 "$CODE_PID" 2>/dev/null; then
      kill -9 "$CODE_PID" 2>/dev/null || true
    fi
  fi

  echo "[LocalCoders] All processes and models successfully stopped."
}

trap cleanup EXIT INT TERM HUP

cd "${CODE_OSS_DIR}"

# Launch Code - OSS with arguments
if [ $# -eq 0 ]; then
  "${CODE_OSS_DIR}/scripts/code.sh" --no-sandbox "${SCRIPT_DIR}" &
else
  "${CODE_OSS_DIR}/scripts/code.sh" --no-sandbox "$@" &
fi

CODE_PID=$!

# Wait for IDE process to exit
wait "$CODE_PID" 2>/dev/null || true
