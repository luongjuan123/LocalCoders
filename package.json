{
  "name": "localcoders",
  "version": "1.0.0",
  "description": "Open-Source, Multi-Agent AI Coding IDE inspired by Windsurf, Cursor and Antigravity, powered by Ollama",
  "main": "dist-electron/main.js",
  "author": "LocalCoders Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:react": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:react && npm run build:electron",
    "start": "./bin/localcoders .",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development VITE_DEV_SERVER=1 electron .\"",
    "test": "node -r ./test/mock-vscode.js --test test/*.test.js",
    "package:deb": "bash distribution/build-deb.sh",
    "package:appimage": "bash distribution/build-appimage.sh"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "diff": "^8.0.4",
    "lucide-react": "^1.16.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sql.js": "^1.14.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/diff": "^8.0.0",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^41.2.0",
    "electron-builder": "^26.7.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.3",
    "vite": "^8.0.1",
    "wait-on": "^9.0.4"
  }
}
